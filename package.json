{
  "name": "ramtask",
  "version": "1.0.0",
  "description": "Aplicación de tareas personales, compartidas y calendario familiar (PWA + Docker)",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm --workspace=client run build",
    "build:server": "npm --workspace=server run build",
    "build": "npm run build:client && npm run build:server",
    "start": "npm --workspace=server run start",
    "test:api": "npm --workspace=server run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
